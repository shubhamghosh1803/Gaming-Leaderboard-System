# FastAPI Backend API Base URL (teammate's FastAPI + ODBC + MySQL server)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# FastAPI Neo4j endpoints (separate from the PostgreSQL API base URL)
VITE_NEO4J_API_BASE_URL=http://127.0.0.1:8001

# Set to "false" to connect to the live FastAPI backend, or "true" for standalone frontend simulation
VITE_USE_MOCK=true
